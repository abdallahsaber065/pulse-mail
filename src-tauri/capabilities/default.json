{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window, least privilege: only listening to our own events and calling our own commands (each listed). No window, path, menu, tray, webview or plugin APIs are exposed to the web UI.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-status",
    "allow-sign-in",
    "allow-sign-out",
    "allow-list-labels",
    "allow-list-threads",
    "allow-category-counts",
    "allow-otp-feedback",
    "allow-search",
    "allow-search-server",
    "allow-set-account-settings",
    "allow-account-storage",
    "allow-get-thread",
    "allow-sync-now",
    "allow-take-pending-open",
    "allow-copy-text",
    "allow-open-external",
    "allow-set-destroy-on-close",
    "allow-set-autostart",
    "allow-load-thread",
    "allow-modify-thread",
    "allow-create-selection",
    "allow-selection-members",
    "allow-mark-selection-read",
    "allow-get-activity",
    "allow-set-notifications",
    "allow-account-estimates",
    "allow-finish-onboarding",
    "allow-set-sync-window",
    "allow-pause-history",
    "allow-resume-history",
    "allow-compose-context",
    "allow-save-draft",
    "allow-delete-draft",
    "allow-send-message",
    "allow-cancel-send",
    "allow-stage-attachment",
    "allow-unstage-attachment",
    "allow-render-message",
    "allow-set-image-sender",
    "allow-set-pref",
    "allow-save-attachment"
  ]
}
