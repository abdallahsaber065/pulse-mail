{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse Mail",
  "version": "0.2.1",
  "identifier": "com.abdallah.pulsemail",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Pulse Mail",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#f8fafd"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'sha256-AN83JXsY2Sn94ALNcDLsz1r4M9uyKHUVCfPWXkK8kVk='",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "worker-src": "'none'",
        "media-src": "'none'",
        "manifest-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'sha256-AN83JXsY2Sn94ALNcDLsz1r4M9uyKHUVCfPWXkK8kVk='",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "worker-src": "'none'",
        "media-src": "'none'",
        "manifest-src": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
